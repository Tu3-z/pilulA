# Copie este arquivo para ".env" (na mesma pasta backend/) e preencha.
# O .env fica só no seu computador: ele está no .gitignore e NUNCA deve ir pro GitHub.
#
# Onde achar no Supabase: botão "Connect" (no topo do projeto) → aba "Connection String"
# → escolha "Type: JDBC" e "Method: Session pooler".
# A URL vem como jdbc:postgresql://HOST:5432/postgres?user=...&password=...
# Use só a parte até "/postgres" no DB_URL e coloque usuário e senha nas linhas de baixo.

DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA_DO_BANCO


# JWT: chave secreta que assina os tokens de login. Precisa ter NO MÍNIMO 32 caracteres
# e ser aleatória. Gere a sua no PowerShell com:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
# e cole o resultado abaixo. Cada pessoa do grupo pode ter a sua; se trocar, quem
# estava logado só precisa entrar de novo.
JWT_SECRET=TROQUE_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
# tempo de vida do token em milissegundos (86400000 = 24h)
JWT_EXPIRACAO_MS=86400000